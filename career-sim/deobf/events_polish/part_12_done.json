{
  "revisions": [
    {"id": "S1612", "polished": "训练完，手机上有条未接来电，区号是北京。拨回去，那头只说了一句：下周一，香河报到，行李按十天准备。"},
    {"id": "S1613", "polished": "国家队的电话"},
    {"id": "S1614", "polished": "先给家里打电话"},
    {"id": "S1615", "polished": "你妈在那头沉默了很久，最后问的是「衣服够不够穿」。你爸在旁边一直咳嗽，什么也没说。"},
    {"id": "S1616", "polished": "谁也不说，先去加练"},
    {"id": "S1617", "polished": "你怕这事是假的，也怕说出去就黄了。名单公布那天，你正跑第四组折返跑。"},
    {"id": "S1618", "polished": "球进的那一下你其实没看清。等反应过来，队友已经跑过了半场，正朝你冲来。"},
    {"id": "S1619", "polished": "第一个国家队进球"},
    {"id": "S1620", "polished": "跑向看台，对着那面旗"},
    {"id": "S1621", "polished": "那张照片后来印在很多地方。你自己留的那张是手机拍的——看台上一个举着旗的人，脸都糊了。"},
    {"id": "S1622", "polished": "捡球回中圈，比赛还没完"},
    {"id": "S1623", "polished": "解说说了一句「他没庆祝」。那场最后 1 比 1，你站在中圈等开球，始终没坐下。"},
    {"id": "S1624", "polished": "最后一轮。赢，还有一线机会；输，就是下一个四年。客场，八万人里坐着两千个中国球迷。"},
    {"id": "S1625", "polished": "世预赛最后一轮"},
    {"id": "S1626", "polished": "全场压上去踢"},
    {"id": "S1627", "polished": "你在最后十分钟扑"},
    {"id": "S1628", "polished": "出了一记必进球。"},
    {"id": "S1629", "polished": "终场哨响时看台上"},
    {"id": "S1630", "polished": "那两千人喊的是你"},
    {"id": "S1631", "polished": "的名字。"},
    {"id": "S1632", "polished": "你在最后十分钟把"},
    {"id": "S1633", "polished": "对方前锋的那脚射"},
    {"id": "S1634", "polished": "门挡了出去。终场"},
    {"id": "S1635", "polished": "哨响时看台上那两"},
    {"id": "S1636", "polished": "千人喊的是你的名"},
    {"id": "S1637", "polished": "字。"},
    {"id": "S1638", "polished": "你在第 88 分"},
    {"id": "S1639", "polished": "钟把球捅了进去。"},
    {"id": "S1640", "polished": "0 比 2。回程飞机上没人说话。落地，通道口有人喊「谢谢你们」，也有人喊了别的。"},
    {"id": "S1641", "polished": "先守住，别输太难看"},
    {"id": "S1642", "polished": "0 比 0。教练组称之为「务实的一分」。回国后，没有人再提这场球。"},
    {"id": "S1643", "polished": "大赛第一场，中圈线上唱国歌。左边的队友唱到一半哭了；右边那个，一个字都没张嘴。"},
    {"id": "S1644", "polished": "国歌"},
    {"id": "S1645", "polished": "跟着唱完"},
    {"id": "S1646", "polished": "转播镜头正好扫过你。那个画面第二天被做成了很多张图，配的字你后来都看过。"},
    {"id": "S1647", "polished": "只想着待会儿的第一脚球"},
    {"id": "S1648", "polished": "你满脑子都是对面那个左后卫的转身速度。开场第七分钟，你从他那一侧过了人。"},
    {"id": "S1649", "polished": "又换帅了，这次来的是个外教。他带的第一期名单里没有你。助理教练私下说：「他喜欢跑得多的。」"},
    {"id": "S1650", "polished": "新国家队主帅"},
    {"id": "S1651", "polished": "按他的要求改"},
    {"id": "S1652", "polished": "你把冬训的量加了三成，跑动数据发给了助教。第三期名单上你的名字排在最后一个——但它在。"},
    {"id": "S1653", "polished": "不改，等他下课"},
    {"id": "S1654", "polished": "他两年后就走了，走时战绩 3 胜 9 负。下一任的第一期名单，把你叫了回去。"},
    {"id": "S1655", "polished": "他待了四年。四年里，你没在国家队上过一场。等他走的时候，你已经过了三十。"},
    {"id": "S1656", "polished": "老队长退了。教练组在赛前把袖标放在你的柜子上，没说话，也没问你愿不愿意。"},
    {"id": "S1657", "polished": "国家队队长"},
    {"id": "S1658", "polished": "从那以后每场输球，混合采访区都是你去站。有一次你站了二十六分钟，回到更衣室，饭已经凉了。"},
    {"id": "S1659", "polished": "说给更合适的人"},
    {"id": "S1660", "polished": "你说队里有人比你更会说话。那人戴了两年袖标，那些最难的问题，都由你来挡。"},
    {"id": "S1661", "polished": "国家队来了三个归化球员，战术会得配两个翻译。主教练布置定位球，讲一句，停一句。"},
    {"id": "S1662", "polished": "更衣室里的两种话"},
    {"id": "S1663", "polished": "主动去跟他们练配合"},
    {"id": "S1664", "polished": "每天训练后你多留半小时，跟他们跑那几条线路。三个月后，那套战术是全队唯一练熟的东西。"},
    {"id": "S1665", "polished": "各踢各的"},
    {"id": "S1666", "polished": "场上传球总是慢半拍。赛后媒体统计，那场全队的传球成功率，小组垫底。"},
    {"id": "S1667", "polished": "客场打西亚，开球是当地凌晨零点。整场有人拿激光笔照你们。第 70 分钟，主队球迷开始往场里扔东西。"},
    {"id": "S1668", "polished": "西亚客场"},
    {"id": "S1669", "polished": "踢完它"},
    {"id": "S1670", "polished": "你被激光笔照了整"},
    {"id": "S1671", "polished": "整四十分钟，还是"},
    {"id": "S1672", "polished": "把那记远射按在了"},
    {"id": "S1673", "polished": "地上。赛后你眼睛"},
    {"id": "S1674", "polished": "红得睁不开。"},
    {"id": "S1675", "polished": "整四十分钟。终场"},
    {"id": "S1676", "polished": "哨响你第一个走向"},
    {"id": "S1677", "polished": "客场看台，鞠了个"},
    {"id": "S1678", "polished": "躬。"},
    {"id": "S1679", "polished": "带头去找裁判"},
    {"id": "S1680", "polished": "裁判把比赛中断了八分钟。那八分钟，你们全队站在中圈，谁也没坐下。"},
    {"id": "S1681", "polished": "裁判给了你一张黄牌，理由是「异议」。下一场，你停赛。"},
    {"id": "S1682", "polished": "对日本还是对韩国，这些年已经没什么区别了——赛前所有人只说一句「至少别输太多」。"},
    {"id": "S1683", "polished": "那场球"},
    {"id": "S1684", "polished": "把这场当决赛踢"},
    {"id": "S1685", "polished": "你扑掉了那记点球"},
    {"id": "S1686", "polished": "。那一晚全国的社"},
    {"id": "S1687", "polished": "交平台都在放同一"},
    {"id": "S1688", "polished": "段十秒的视频。"},
    {"id": "S1689", "polished": "你在最后一分钟把"},
    {"id": "S1690", "polished": "对方那记必进的射"},
    {"id": "S1691", "polished": "门封了下来。那一"},
    {"id": "S1692", "polished": "晚全国的社交平台"},
    {"id": "S1693", "polished": "都在放同一段十秒"},
    {"id": "S1694", "polished": "的视频。"},
    {"id": "S1695", "polished": "你打进了那个球。"},
    {"id": "S1696", "polished": "那一晚全国的社交"},
    {"id": "S1697", "polished": "平台都在放同一段"},
    {"id": "S1698", "polished": "十秒的视频。"},
    {"id": "S1699", "polished": "0 比 3。你跑了 11.8 公里，全队最多。这个数字，第二天没人提。"},
    {"id": "S1700", "polished": "保存体力，还有联赛"},
    {"id": "S1701", "polished": "六十分钟你就被换下了。回俱乐部，你连着三场首发。没人再问你国家队的事。"},
    {"id": "S1702", "polished": "脚踝还肿着，队医说再养两周就好。国家队那边，这一期是大赛前最后一次集训。"},
    {"id": "S1703", "polished": "带着伤去报到"},
    {"id": "S1704", "polished": "打封闭去"},
    {"id": "S1705", "polished": "你打了三针，两场都踢满。回俱乐部那天走路还有点跛，可大赛名单上有你。"},
    {"id": "S1706", "polished": "第二场，三十分钟你就下来了。那只脚踝后来疼了整整一年，阴雨天尤其厉害。"},
    {"id": "S1707", "polished": "跟国家队请假"},
    {"id": "S1708", "polished": "你在俱乐部养了两周。名单公布那天，你坐在电视前一个个看过去——没有你。"},
    {"id": "S1709", "polished": "足协定了：大赛前封闭集训四个月，联赛为此让路。俱乐部的教练在电话里问你：「你是我的球员，还是他们的？」"},
    {"id": "S1710", "polished": "长期集训"},
    {"id": "S1711", "polished": "去集训"},
    {"id": "S1712", "polished": "四个月里你打了十四场热身赛，对手大多没听说过。回俱乐部那天，你的号码已经归了别人。"},
    {"id": "S1713", "polished": "找理由留在俱乐部"},
    {"id": "S1714", "polished": "你交了一份体检报告。那一年的国家队名单上，再没有你的名字——直到换帅。"},
    {"id": "S1715", "polished": "又输了一场不该输的球。凌晨落地，出口通道两边站满了人——有举横幅的，有只是站着看的。"},
    {"id": "S1716", "polished": "机场那道通道"},
    {"id": "S1717", "polished": "摘掉耳机走过去"},
    {"id": "S1718", "polished": "你走得很慢，始终没低头。一个小孩隔着栏杆递过来一张纸，上面画着球场。"},
    {"id": "S1719", "polished": "有人喊了一句很难听的话。你站住，看了他两秒。那两秒，后来被传了三百万次。"},
    {"id": "S1720", "polished": "跟着大巴从侧门走"},
    {"id": "S1721", "polished": "俱乐部的车等在侧门。你在车上睡了四十分钟——那半个月，睡得最沉的一觉。"},
    {"id": "S1722", "polished": "热身时，看台第一排坐着个孩子，穿着国家队球衣，背后印着你的号码和名字。"},
    {"id": "S1723", "polished": "看台上那件球衣"},
    {"id": "S1724", "polished": "赛后把球衣给他"},
    {"id": "S1725", "polished": "他哭了。他爸妈在旁边一个劲儿道谢。那件球衣，是那个赛季你唯一没留下的。"},
    {"id": "S1726", "polished": "记住这件事"},
    {"id": "S1727", "polished": "从那以后，国家队的每一场你都跑到抽筋。为什么，你没跟任何人说过。"},
    {"id": "S1728", "polished": "新一期名单里还有你，可你知道自己跟不上那个节奏了。训练里，年轻人一次次从你身边过去，一次比一次快。"},
    {"id": "S1729", "polished": "退出国家队"},
    {"id": "S1730", "polished": "打完这一届再说"},
    {"id": "S1731", "polished": "你又打了一年。最后一场，客场，输了。你踢满九十分钟，赛后一个人在场地中间站了很久。"},
    {"id": "S1732", "polished": "发一条声明"},
    {"id": "S1733", "polished": "你写了三百来字，最后一句是「这件球衣我穿了很多年，现在该给别人穿了」。那条消息下面，有十万条评论。"},
    {"id": "S1734", "polished": "训练完，手机上有三条消息，来自三个人。你在更衣室门口站了很久，没有一条是关于球的。"},
    {"id": "S1735", "polished": "有人在等你"},
    {"id": "S1736", "polished": "老家从小一起踢球的"},
    {"id": "S1737", "polished": "你们八岁就认识。那时候她比你还敢往人堆里冲。她说这些年你的比赛，一场都没落。"},
    {"id": "S1738", "polished": "队里的康复师"},
    {"id": "S1739", "polished": "她给你处理了两年脚踝，知道你每一处旧伤。第一次约饭，她开口第一句：「今天别喝冰的。」"},
    {"id": "S1740", "polished": "评论区里那个总在的人"},
    {"id": "S1741", "polished": "她做美食账号，粉丝比你多。见面那天，她把手机反扣在桌上，说今天不拍。"},
    {"id": "S1742", "polished": "现在只想踢球"},
    {"id": "S1743", "polished": "三条消息，你都没回。那年冬训你是全队跑得最多的，总结会上教练点了你的名。"},
    {"id": "S1744", "polished": "又一年冬歇，家里安排了个饭局。对方是牙医，坐下第一句：「你们踢球的，膝盖是不是都不太好？」"},
    {"id": "S1745", "polished": "三十岁那年"},
    {"id": "S1746", "polished": "试试看"},
    {"id": "S1747", "polished": "第二次见面，她把你的旧片子翻了一遍，说不归她管，但她认识人。你笑了很久。"},
    {"id": "S1748", "polished": "还是算了"},
    {"id": "S1749", "polished": "你说自己这几年跑来跑去，怕耽误人家。回去的路上下了雪，你一个人走了两站地。"},
    {"id": "S1750", "polished": "一个百万粉丝的主播在直播里说你是她的偶像。第二天，她的助理联系了你的经纪人。"},
    {"id": "S1751", "polished": "直播间"},
    {"id": "S1752", "polished": "见一面"},
    {"id": "S1753", "polished": "你们的合照第二天传得到处都是。评论里一半在祝福，一半在算她的粉丝值多少钱。"},
    {"id": "S1754", "polished": "让经纪人回绝"},
    {"id": "S1755", "polished": "经纪人说，这种流量不要白不要。你说，你要的不是这种。"}
  ]
}
